{
  "name": "everydashcam",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "No-backend, in-browser dashcam recording viewer: multi-channel playback, GPS track on a map, speed/G-force chart, and re-encode-free clip export - all local, nothing uploaded.",
  "license": "AGPL-3.0-only",
  "author": "Alexander Kulikov",
  "homepage": "https://everydashcam.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everydashcam/everydashcam.git"
  },
  "bugs": {
    "url": "https://github.com/everydashcam/everydashcam/issues"
  },
  "keywords": [
    "dashcam",
    "dashcam-viewer",
    "gps",
    "gpmf",
    "webcodecs",
    "maplibre",
    "mp4",
    "70mai",
    "no-backend"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/validate-map-styles.mjs && node scripts/parser-cache-revisions.mjs --check",
    "build": "vite build && node scripts/generate-third-party-notices.mjs && node scripts/check-seo.mjs",
    "prebuild:portable": "node scripts/validate-map-styles.mjs && node scripts/parser-cache-revisions.mjs --check",
    "build:portable": "node --experimental-strip-types scripts/build-portable.mjs",
    "test:portable": "npm run build:portable && playwright test --config=tests/playwright.portable.config.ts",
    "build:encoder-test": "tsc -p scripts/encoder-test/tsconfig.json && node scripts/build-encoder-test.mjs",
    "test:encoder-test": "npm run build:encoder-test && playwright test --config=tests/playwright.encoder-test.config.ts",
    "check:seo": "node scripts/check-seo.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/validate-map-styles.mjs && node scripts/parser-cache-revisions.mjs --check",
    "test": "TZ=UTC vitest run",
    "test:deployment-profile": "TZ=UTC vitest run src/i18n/deployment-profile.test.ts src/i18n/seo-prerender-build.test.ts src/i18n/static-search-meta.test.ts src/csp-hash.integration.test.ts src/sw-precache.integration.test.ts",
    "test:watch": "TZ=UTC vitest",
    "test:coverage": "TZ=UTC vitest run --coverage",
    "test:perf": "playwright test --config=tests/playwright.perf.config.ts",
    "test:e2e": "VITE_YANDEX_TILES_API_KEY=e2e-yandex-key npm run build && playwright test --config=tests/playwright.e2e.config.ts",
    "test:e2e:golden": "npm run test:e2e -- --grep @golden-",
    "test:e2e:blur": "npm run test:e2e -- --grep @golden-blur",
    "test:e2e:export": "npm run test:e2e -- --grep @golden-export",
    "test:e2e:offline": "npm run test:e2e -- --grep @golden-offline",
    "test:e2e:playback": "npm run test:e2e -- --grep @golden-playback",
    "test:e2e:map": "npm run test:e2e -- --grep @golden-map",
    "test:e2e:ingest": "npm run test:e2e -- --grep @golden-ingest",
    "test:vrt": "npm run build && playwright test --config=tests/playwright.vrt.config.ts",
    "test:vrt:update": "npm run build && playwright test --config=tests/playwright.vrt.config.ts --update-snapshots",
    "test:bench": "vitest bench --run --config tests/vitest.bench.config.ts",
    "lint": "biome lint src tests",
    "format": "biome format src tests --write",
    "check": "biome check src tests --write",
    "check:ci": "biome ci src tests",
    "knip": "knip",
    "indexnow": "node scripts/indexnow-ping.mjs",
    "generate:changelog": "node scripts/generate-changelog-md.mjs",
    "generate:parser-cache-revisions": "node scripts/parser-cache-revisions.mjs",
    "validate:parser-cache-revisions": "node scripts/parser-cache-revisions.mjs --check",
    "validate:styles": "node scripts/validate-map-styles.mjs",
    "screenshots:readme": "node scripts/generate-readme-screenshots.mjs"
  },
  "dependencies": {
    "@sentry/browser": "^11.8.0",
    "chart.js": "4.5.1",
    "chartjs-plugin-zoom": "2.2.0",
    "idb": "^8.0.4",
    "intl-messageformat": "^12.1.3",
    "maplibre-gl": "6.14.0",
    "mediabunny": "1.61.6",
    "native-file-system-adapter": "3.0.1",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@playwright/test": "^1.64.1",
    "@sentry/cli": "^3.8.0",
    "@sentry/vite-plugin": "^11.8.0",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "@xmldom/xmldom": "^0.9.12",
    "html-minifier-terser": "^7.2.0",
    "knip": "^6.41.0",
    "rolldown": "1.2.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
