# Env file template. Vite reads .env / .env.local / .env.production.local
# at build/dev time. Variables prefixed VITE_ get inlined into the bundle
# (accessible via `import.meta.env.VITE_*`). Build-only variables without that
# prefix must be exported in the build process or set in CI; Vite does not copy
# them from dotenv files into process.env.
#
# Local development: copy this file to `.env.local` (gitignored) and fill in
# your own VITE_ values. Official deployments use GitHub Actions variables and
# secrets; see docs/deploy.md.
#
# Sentry DSN for crash-reporting (errors-only). Public (visible in the
# bundle), not a secret. Own value per environment (beta -> beta project DSN,
# prod -> prod project DSN). Semantics:
#  - absent or empty value -> the SDK and its initialization chunk are removed
#    from the build. This is the mode for self-host forks and dev.
#  - valid DSN -> crash-reporting is enabled by default; users can disable it in Settings.
# The build adds only the DSN's HTTP(S) origin to the reporting CSP allowlist.
# Server-side is mandatory too: in the Sentry project enable "Prevent Storing
# of IP Addresses" (Settings -> Security & Privacy) - the client-side
# dataCollection restrictions are necessary but not sufficient. Runtime options
# and the explicit integration allowlist live in src/sentry-init.ts.
VITE_SENTRY_DSN=

# --- Sentry source map upload (build-time, WITHOUT the VITE_ prefix) ---
# Uploads source maps to Sentry so crash stack traces read in the
# original TS, not minified code. Active only when ALL THREE variables are
# set. Web builds always emit public source maps for DevTools, including
# self-hosted artifacts. The official GitHub Actions workflows upload maps in a
# bounded, non-fatal step and retain them in the deployed dist. The
# auth token is SECRET (unlike the public DSN above); the organization/project
# slugs are build-only metadata. None are inlined into the client bundle.
#  - SENTRY_AUTH_TOKEN - a token with scope project:releases + org:read. Create it:
#    Sentry -> Settings -> Auth Tokens (Organization Tokens).
#  - SENTRY_ORG / SENTRY_PROJECT - org and project slugs.
# Export these in the build process; putting them only in .env.local has no effect.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- CSP delivery for header-less hosts (build-time, node context only) ---
# Set META_CSP=1 to additionally deliver the Content-Security-Policy as a
# <meta> tag in every built HTML - for servers that cannot send response
# headers (GitHub Pages, `npx serve`, `python -m http.server`). Off by
# default: on Cloudflare the header CSP from public/_headers already
# enforces, and a meta copy would keep enforcing even when the header is
# rolled back to Report-Only. The release artifact and the self-build
# Docker image set it; see vite-plugins/csp-hash.ts.
META_CSP=

# Optional Yandex Tiles API key. Public in the browser bundle and tile requests.
# If domain restrictions are available for your key, set them for your site.
# They do not keep the key private; see docs/self-hosting.md for their limits.
# If the dashboard has no such field, continue without it.
# Leave empty to keep Yandex unavailable; self-host builds use their own key.
VITE_YANDEX_TILES_API_KEY=

# Portable HTML embeds a browser key only when this variable is exported in
# the build process. The portable builder does not read .env files.
PORTABLE_YANDEX_TILES_API_KEY=

# Initial viewer provider: openfreemap (default), osm-vector, or yandex.
# Saved choices take priority. Yandex without a key falls back to OpenFreeMap.
VITE_DEFAULT_MAP_PROVIDER=
